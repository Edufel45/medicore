{% extends "base.html" %}
{% block title %}Nurse — MediCore{% endblock %}

{% block content %}
  <h1>Good morning</h1>
  <p class="sub">Nurse · record vitals, then send the patient back to the doctor.</p>

  <div class="g4" style="display:grid;grid-template-columns:repeat(4,1fr);gap:14px;margin-bottom:16px">
    <div class="card"><small style="display:block;color:var(--muted);font-size:.74rem">Awaiting vitals</small><b style="font-size:1.5rem;color:var(--navy)">0</b></div>
    <div class="card"><small style="display:block;color:var(--muted);font-size:.74rem">Requested by doctor</small><b style="font-size:1.5rem;color:var(--navy)">0</b></div>
    <div class="card"><small style="display:block;color:var(--muted);font-size:.74rem">Completed today</small><b style="font-size:1.5rem;color:var(--navy)">0</b></div>
    <div class="card"><small style="display:block;color:var(--muted);font-size:.74rem">Avg time</small><b style="font-size:1.5rem;color:var(--navy)">— min</b></div>
  </div>

  <div class="card">
    <h2>Quick actions</h2>
    <div class="row click" onclick="alert('Queue — Phase 4')">
      <div class="l"><b>🧭 Open nurse queue</b><span>Patients awaiting vitals</span></div>
      →
    </div>
    <div class="row click" onclick="alert('Vitals — Phase 5')">
      <div class="l"><b>🩺 Record vitals</b><span>BP, temperature, weight, pulse</span></div>
      →
    </div>
  </div>
{% endblock %}