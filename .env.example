# =====================================================
# MediCore — Environment Variables Template
# Copy this to .env and fill in the real values.
# NEVER commit .env to git.
# =====================================================

# ---------- Django ----------
DJANGO_SECRET_KEY=change-me-to-a-50-char-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,.onrender.com
DJANGO_TIME_ZONE=Africa/Nairobi
DJANGO_LANGUAGE_CODE=en-us

# ---------- Database ----------
# Local dev (SQLite):
DATABASE_URL=sqlite:///db.sqlite3
# Production (Supabase Postgres — use the connection pooler, port 6543):
# DATABASE_URL=postgresql://postgres.xxxx:[password]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres

# ---------- Supabase Storage (optional, for PDF receipts in production) ----------
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=
SUPABASE_STORAGE_BUCKET=medicore

# ---------- Safaricom Daraja (M-Pesa) ----------
# Get credentials at https://developer.safaricom.co.ke
# In sandbox, the shortcode is 174379 and the passkey is published on the portal.
DARAJA_ENV=sandbox
DARAJA_CONSUMER_KEY=
DARAJA_CONSUMER_SECRET=
DARAJA_SHORTCODE=174379
DARAJA_PASSKEY=
DARAJA_CALLBACK_URL=http://localhost:8000/mpesa/callback/stk/
DARAJA_INITIATOR_NAME=testapi
DARAJA_INITIATOR_PASSWORD=
DARAJA_SECURITY_CREDENTIAL=

# ---------- SHA (Social Health Authority) ----------
# Use "mock" for the demo (no real SHA API available).
SHA_PROVIDER=mock
SHA_API_BASE=https://sha-hmis.go.ke/api
SHA_API_KEY=
SHA_FACILITY_CODE=

# ---------- Celery ----------
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
# Set to True in dev to run tasks synchronously (no worker needed):
CELERY_TASK_ALWAYS_EAGER=True

# ---------- Email (console in dev) ----------
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=no-reply@medicore.local